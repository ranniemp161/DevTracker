{
  "name": "devtrack",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @devtrack/database db:generate",
    "db:migrate": "pnpm --filter @devtrack/database db:migrate"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  }
}
