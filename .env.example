# Copy to `.env` in the repository root. `.env` is git-ignored; never commit real values.

NODE_ENV=development

# --- Database (Neon) ---
# Use the *pooled* Neon connection string (host contains "-pooler") with sslmode=require.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/devtrack?sslmode=require

# --- API ---
API_PORT=4000
# Public origin of the website. Used for CORS/Origin checks and for links in emails.
WEB_ORIGIN=http://localhost:3000
# Set to the number of proxy hops in front of the API (e.g. 1 behind Vercel/Next rewrites), or "false".
TRUST_PROXY=1

# --- Website ---
# Where the Next.js server proxies /api/v1/* to. The browser never calls the API origin directly.
API_INTERNAL_URL=http://localhost:4000

# --- GitHub OAuth (login only — this is NOT the GitHub App) ---
# Create at https://github.com/settings/developers -> OAuth Apps.
# Authorization callback URL: http://localhost:3000/api/v1/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Email ---
# "console" prints emails to the API log (development only; rejected in production).
MAIL_TRANSPORT=console
MAIL_FROM="DevTrack <no-reply@devtrack.local>"
