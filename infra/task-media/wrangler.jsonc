{
  "name": "devtrack-task-media",
  "main": "edge.mjs",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "preview_urls": false,
  "r2_buckets": [{ "binding": "TASK_MEDIA", "bucket_name": "devtracker" }],
  "cache": { "enabled": true },
  "exports": {
    "default": { "type": "worker", "cache": { "enabled": false } },
    "CachedMedia": { "type": "worker", "cache": { "enabled": true } },
  },
}
